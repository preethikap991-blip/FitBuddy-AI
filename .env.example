APP_NAME=FitBuddy
DATABASE_URL=sqlite:///./fitbuddy.db

# Gemini API configuration
GEMINI_API_KEY=
# Keep separate model settings so the architecture can use different models for
# workout generation and quick tips.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash

# Set true to run without a Gemini API key.
# Tests use demo mode automatically.
DEMO_MODE=true

# Optional admin display label. This is not authentication.
ADMIN_NAME=FitBuddy Admin
